    "@types/node": "^22.10.7",
    "dotenv-cli": "^11.0.0",
    "globals": "^16.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
