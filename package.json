{
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "dotenv -e .env -- nest start --watch",
    "start:dev:server": "dotenv -e ../.env -- nest start --watch",
    "start:prod": "node dist/src/main",
    "typeorm": "npx typeorm -d dist/common/utils/databaseMigrations.js",
    "migration:generate": "npm run typeorm -- migration:generate -o",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "crypto": "^1.0.1",
    "moment": "^2.30.1",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "pino-loki": "^2.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
